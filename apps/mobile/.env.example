# EXPO_PUBLIC_* vars are inlined at BUILD time, not read at runtime.
# After changing this file you MUST restart with: npx expo start --clear
# For production builds, also set this in eas.json under build.production.env
#
# Must be https:// — Android and iOS block cleartext HTTP to remote hosts.
EXPO_PUBLIC_API_URL=https://your-app.up.railway.app
