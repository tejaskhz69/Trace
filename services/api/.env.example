# ---------------------------------------------------------------------------
# Copy to .env for local dev. On Railway, set these in the service's
# Variables tab -- a .env file inside the image is NOT read on Railway.
# ---------------------------------------------------------------------------

ENV=development
DEBUG=true
PORT=8000

# Local: docker compose up -d db  (see docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://trace:trace@localhost:5432/trace
# On Railway: reference the Postgres plugin variable instead --
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# The app normalises postgres:// and postgresql:// to the asyncpg driver.

# ---------------------------------------------------------------------------
# JWT_SECRET IS THE #1 CAUSE OF "LOGIN WORKS LOCALLY BUT NOT IN PRODUCTION".
# Generate once and NEVER change it, or every issued token is invalidated:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_generate_with_the_command_above
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=60

# Only affects Expo Web / browsers. Native RN never sends an Origin header.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Open Food Facts asks for a descriptive UA with a contact address.
OFF_USER_AGENT=Trace/0.1 (you@yourdomain.com)

# Free key: https://fdc.nal.usda.gov/api-key-signup.html
USDA_FDC_API_KEY=

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
VISION_MODEL_FAST=gemini-3.5-flash
VISION_MODEL_ACCURATE=gemini-3.7-flash  # 3.1-pro-preview has 0 free-tier quota
CHAT_MODEL=gemini-3.5-flash
FREE_TIER_SCANS_PER_DAY=3
